{
  "name": "coz-sw-matcher",
  "version": "0.2.0",
  "description": "Compuzone product-name parsing and official software URL candidates with human approval",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoMongYi/coz-sw-matcher.git"
  },
  "homepage": "https://github.com/HoMongYi/coz-sw-matcher#readme",
  "bugs": {
    "url": "https://github.com/HoMongYi/coz-sw-matcher/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "coz-sw-matcher": "bin/coz-sw-matcher.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin/coz-sw-matcher.mjs",
    "src",
    "data/public",
    "schemas",
    "config",
    "skills",
    "examples/match-request.json",
    "examples/web-app-request.json",
    "examples/compuzone-integration.mjs",
    "docs",
    "reports/VERIFICATION.md",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "reports/RELEASE_NOTES_v0.1.0.md",
    "reports/RELEASE_NOTES_v0.2.0.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "validate": "node scripts/validate.mjs",
    "release:build": "node scripts/release.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "csv:import": "node scripts/import-reviewed-csv.mjs",
    "evaluate": "node scripts/evaluate-reviewed-csv.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "ajv": "8.20.0",
    "csv-parse": "7.0.3",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "^2.3.0",
    "tldts": "7.4.16",
    "yaml": "^2.8.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0"
  }
}

{
  "$id": "hsuf-vendor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "aliases",
    "domains",
    "classification",
    "provenance",
    "verified_at",
    "noise_tokens",
    "model_aliases",
    "models",
    "rules",
    "ecosystems"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+$"
      }
    },
    "classification": {
      "enum": [
        "PUBLIC_SOURCE_ONLY",
        "SYNTHETIC",
        "UNKNOWN"
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "noise_tokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "status",
          "provenance"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "status": {
            "enum": [
              "confirmed",
              "needs-refresh"
            ]
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/record"
      }
    },
    "ecosystems": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/record"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "when",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "priority": {
            "type": "number"
          },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "brand_any": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "name_any": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "name_all": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "name_none": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "action": {
            "enum": [
              "ecosystem",
              "model_page"
            ]
          },
          "ecosystem_id": {
            "type": "string"
          },
          "allowed_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbid_url_regex": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "delegated_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "delegated_evidence_url_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allow_hub": {
            "type": "boolean"
          },
          "allow_delegated_root": {
            "type": "boolean"
          }
        }
      }
    },
    "support_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "domains",
          "source_url",
          "observed_fact",
          "checked_at"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_url": {
            "type": "string"
          },
          "observed_fact": {
            "type": "string"
          },
          "checked_at": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonical_page",
        "status",
        "verified_at",
        "provenance",
        "support_mode",
        "supported_models",
        "excluded_models"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "canonical_page": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "deprecated",
            "retired",
            "replaced",
            "needs-refresh"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "support_mode": {
          "enum": [
            "exact",
            "explicit-model-list",
            "family-rule",
            "regional-driver",
            "documented-relation"
          ]
        },
        "supported_models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "successor": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule_id": {
          "type": "string"
        },
        "software_kind": {
          "type": "string"
        },
        "max_age_days": {
          "type": "integer",
          "minimum": 1
        },
        "request_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "customer_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "download_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "support_models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variant_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "availability": {
          "enum": [
            "available",
            "none",
            "unknown"
          ]
        },
        "page_role": {
          "enum": [
            "model-hub",
            "software-hub",
            "web-tool"
          ]
        },
        "customer_priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "locale_exception": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relationship",
              "source_url",
              "models",
              "observed_fact",
              "checked_at",
              "match_text",
              "unknowns"
            ],
            "properties": {
              "relationship": {
                "enum": [
                  "software-support",
                  "driver-support",
                  "common-manual",
                  "regional-name",
                  "configuration-profile",
                  "official-distribution",
                  "software-absence"
                ]
              },
              "source_url": {
                "type": "string"
              },
              "target_url": {
                "type": "string"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "software_kind": {
                "type": "string"
              },
              "software_name": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "observed_fact": {
                "type": "string"
              },
              "checked_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "match_text": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unknowns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "package": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file_name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "published_at": {
                    "type": "string"
                  },
                  "os": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "architectures": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "languages": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "features": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "limitations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "launch_url": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
